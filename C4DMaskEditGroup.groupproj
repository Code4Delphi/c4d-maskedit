<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{14BDF014-002B-4D65-832F-8EEAA11A9CD4}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="C4DMaskEdit.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="Samples\Demo01\C4DMaskEditDemo01.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="C4DMaskEdit">
        <MSBuild Projects="C4DMaskEdit.dproj"/>
    </Target>
    <Target Name="C4DMaskEdit:Clean">
        <MSBuild Projects="C4DMaskEdit.dproj" Targets="Clean"/>
    </Target>
    <Target Name="C4DMaskEdit:Make">
        <MSBuild Projects="C4DMaskEdit.dproj" Targets="Make"/>
    </Target>
    <Target Name="C4DMaskEditDemo01">
        <MSBuild Projects="Samples\Demo01\C4DMaskEditDemo01.dproj"/>
    </Target>
    <Target Name="C4DMaskEditDemo01:Clean">
        <MSBuild Projects="Samples\Demo01\C4DMaskEditDemo01.dproj" Targets="Clean"/>
    </Target>
    <Target Name="C4DMaskEditDemo01:Make">
        <MSBuild Projects="Samples\Demo01\C4DMaskEditDemo01.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="C4DMaskEdit;C4DMaskEditDemo01"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="C4DMaskEdit:Clean;C4DMaskEditDemo01:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="C4DMaskEdit:Make;C4DMaskEditDemo01:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
